<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dikciz_pressed_overlay" />
            <stroke
                android:width="1dp"
                android:color="@color/dikciz_brand_cheese" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dikciz_widget_background" />
            <stroke
                android:width="1dp"
                android:color="@color/dikciz_control_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
