<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/fixture_configuration_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Fixture widget configuration"
        android:text="Configure fixture widget"
        android:textSize="20sp" />

    <Button
        android:id="@+id/fixture_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cancel" />

    <Button
        android:id="@+id/fixture_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save fixture widget" />
</LinearLayout>
