<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/fixture_accessibility_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="External accessibility fixture"
        android:text="@string/fixture_accessibility_title"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/fixture_accessibility_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:contentDescription="External action count"
        android:textSize="18sp" />

    <Button
        android:id="@+id/fixture_accessibility_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/fixture_accessibility_action"
        android:textAllCaps="false" />
</LinearLayout>
